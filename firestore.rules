rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHardcodedAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        (
          request.auth.token.email == "pcristo35@gmail.com" ||
          request.auth.token.email.lower() == "pcristo35@gmail.com"
        );
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().get('role', '');
    }

    function getUserStatus() {
      return getUserData().get('status', 'active');
    }

    function getUserRestId() {
      return getUserData().get('restaurantId', null);
    }

    function getUserRestIds() {
      return getUserData().get('restaurantIds', []);
    }

    // Only platform owner or users specifically assigned super_admin in Firestore
    function isSuperAdmin() {
      return isHardcodedAdmin() || (
        hasUserDoc() && 
        (getUserRole() == 'super_admin' || getUserRole() == 'superadmin') &&
        getUserStatus() != 'suspended' &&
        getUserStatus() != 'inactive'
      );
    }

    function isMatchingTenant(userRestId, userRestIds, targetRestaurantId) {
      return targetRestaurantId != null && targetRestaurantId != '' && (
        userRestId == targetRestaurantId ||
        ((userRestId == 'main' || userRestId == 'default-restaurant' || userRestId == 'dinemaster-bistro') &&
         (targetRestaurantId == 'main' || targetRestaurantId == 'default-restaurant' || targetRestaurantId == 'dinemaster-bistro')) ||
        ((userRestId == 'bela-italia' || userRestId == 'bella-italia') &&
         (targetRestaurantId == 'bela-italia' || targetRestaurantId == 'bella-italia')) ||
        (userRestIds != null && targetRestaurantId in userRestIds)
      );
    }

    function isRestaurantStaff(restaurantId) {
      return isSuperAdmin() || (
        hasUserDoc() && 
        (
          getUserRole() == 'staff' || 
          getUserRole() == 'admin' || 
          getUserRole() == 'restaurant_owner' || 
          getUserRole() == 'restaurant_manager' || 
          getUserRole() == 'restaurant_staff'
        ) &&
        getUserStatus() != 'suspended' &&
        getUserStatus() != 'inactive' &&
        isMatchingTenant(getUserRestId(), getUserRestIds(), restaurantId)
      );
    }

    function isRestaurantAdmin(restaurantId) {
      return isSuperAdmin() || (
        hasUserDoc() && 
        (
          getUserRole() == 'admin' || 
          getUserRole() == 'restaurant_owner' || 
          getUserRole() == 'restaurant_manager'
        ) &&
        getUserStatus() != 'suspended' &&
        getUserStatus() != 'inactive' &&
        isMatchingTenant(getUserRestId(), getUserRestIds(), restaurantId)
      );
    }

    function isStaff() {
      return isSuperAdmin() || (
        hasUserDoc() && (
          getUserRole() == 'staff' || 
          getUserRole() == 'admin' || 
          getUserRole() == 'restaurant_owner' || 
          getUserRole() == 'restaurant_manager' || 
          getUserRole() == 'restaurant_staff'
        ) &&
        getUserStatus() != 'suspended' &&
        getUserStatus() != 'inactive' &&
        getUserRestId() != null &&
        getUserRestId() != ''
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        hasUserDoc() && (
          getUserRole() == 'admin' || 
          getUserRole() == 'restaurant_owner' || 
          getUserRole() == 'restaurant_manager'
        ) &&
        getUserStatus() != 'suspended' &&
        getUserStatus() != 'inactive' &&
        getUserRestId() != null &&
        getUserRestId() != ''
      );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Multi-tenant Restaurants
    match /restaurants/{restaurantId} {
      allow read: if true; // Public domain & subdomain resolution, branding fetch
      allow create: if isSuperAdmin(); // Only super admins can create restaurant tenants
      allow update: if isSuperAdmin() || isRestaurantAdmin(restaurantId);
      allow delete: if isSuperAdmin();
    }

    // Restaurant Settings (main or restaurant-specific document)
    match /settings/{settingId} {
      allow read: if true; // Public booking needs opening hours and branding
      allow create: if isSuperAdmin() || isRestaurantAdmin(settingId);
      allow update: if isSuperAdmin() || isRestaurantAdmin(settingId);
      allow delete: if isSuperAdmin();
    }

    // Tables floor plan
    match /tables/{tableId} {
      allow read: if true; // Needed for party size matching during booking
      allow create, update: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantStaff(request.resource.data.get('restaurantId', null)));
      allow delete: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
    }

    // Areas in restaurant
    match /areas/{areaId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)));
      allow delete: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
    }

    // Reservations (Strict tenant isolation for staff & customers)
    match /reservations/{reservationId} {
      allow read: if true; // Public guests and authenticated customers need to check availability to book
      allow create: if true; // Public can book reservations
      allow update: if isSuperAdmin() || 
                       (resource.data.get('restaurantId', null) != null && isRestaurantStaff(resource.data.get('restaurantId', null))) ||
                       (resource.data.get('restaurantId', null) == null && isRestaurantStaff('main')) ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'cancellationReason', 'cancelledAt',
                         'date', 'time', 'guests', 'notes', 'specialRequests',
                         'tableId', 'tableName', 'lastModifiedAt', 'lastModifiedBy', 'history',
                         'modificationCount', 'modifiedByCustomer', 'customerModifiedAt',
                         'onlineModificationCount', 'modifiedOnline', 'hasBeenModifiedOnline',
                         'allergies', 'seatingPreference', 'customerPhone', 'customerEmail', 'customerName', 'confirmationEmail', 'reminderEmail', 'customerUid'
                       ]));
      allow delete: if isSuperAdmin() || 
                       (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
    }

    // Customers directory (Strict tenant isolation & privacy protection)
    match /customers/{customerId} {
      allow read: if isSuperAdmin() || 
                     (resource.data.get('restaurantId', null) != null && isRestaurantStaff(resource.data.get('restaurantId', null))) || 
                     (resource.data.get('restaurantId', null) == null && isRestaurantStaff('main')) ||
                     (isAuthenticated() && (
                       request.auth.uid == customerId || 
                       resource.data.get('authUid', '') == request.auth.uid || 
                       (request.auth.token.email != null && (
                         resource.data.get('email', '') == request.auth.token.email ||
                         resource.data.get('email', '') == request.auth.token.email.lower()
                       ))
                     ));
      allow create: if true; // Allow guest/public booking customer record creation
      allow update: if isSuperAdmin() || 
                       (resource.data.get('restaurantId', null) != null && isRestaurantStaff(resource.data.get('restaurantId', null))) || 
                       (resource.data.get('restaurantId', null) == null && isRestaurantStaff('main')) ||
                       (isAuthenticated() && (
                         request.auth.uid == customerId || 
                         resource.data.get('authUid', '') == request.auth.uid || 
                         (request.auth.token.email != null && (
                           resource.data.get('email', '') == request.auth.token.email ||
                           resource.data.get('email', '') == request.auth.token.email.lower()
                         ))
                       ));
      allow delete: if isSuperAdmin() || 
                       (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
    }

    // Users and Staff accounts (Strict tenant isolation & Anti-Privilege Escalation)
    match /users/{userId} {
      allow read: if isSuperAdmin() || 
                     (resource.data.get('restaurantId', null) != null && isRestaurantStaff(resource.data.get('restaurantId', null))) || 
                     (isAuthenticated() && (
                       request.auth.uid == userId || 
                       resource.data.get('authUid', '') == request.auth.uid ||
                       (request.auth.token.email != null && (
                         resource.data.get('email', '') == request.auth.token.email ||
                         resource.data.get('email', '') == request.auth.token.email.lower()
                       ))
                     ));
      allow create: if isSuperAdmin() || 
                       // Public / Customer self-registration: MUST be customer role only, NO administrative permissions or tenant association
                       (
                         isAuthenticated() && 
                         (request.auth.uid == userId || request.resource.data.get('authUid', '') == request.auth.uid) && 
                         request.resource.data.get('role', '') == 'customer' &&
                         !request.resource.data.keys().hasAny(['permissions']) &&
                         (request.resource.data.get('restaurantId', null) == null || request.resource.data.get('restaurantId', '') == '')
                       ) ||
                       // Restaurant Admin creating staff or admin within their own restaurant
                       (
                         request.resource.data.get('restaurantId', null) != null && 
                         isRestaurantAdmin(request.resource.data.get('restaurantId', null)) && 
                         request.resource.data.get('role', '') in ['staff', 'restaurant_staff', 'admin', 'restaurant_manager'] &&
                         request.resource.data.get('role', '') != 'super_admin' &&
                         request.resource.data.get('role', '') != 'superadmin'
                       );
      allow update: if isSuperAdmin() || 
                       // Restaurant Admin updating staff in their restaurant (cannot change own role, cannot create/promote super_admin, cannot switch restaurant)
                       (
                         resource.data.get('restaurantId', null) != null &&
                         isRestaurantAdmin(resource.data.get('restaurantId', null)) &&
                         resource.data.get('role', '') != 'super_admin' &&
                         resource.data.get('role', '') != 'superadmin' &&
                         request.resource.data.get('role', '') in ['staff', 'restaurant_staff', 'admin', 'restaurant_manager', 'restaurant_owner', 'customer'] &&
                         request.resource.data.get('restaurantId', null) == resource.data.get('restaurantId', null) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['restaurantId', 'restaurantIds']) &&
                         // Lockout & privilege protection: Restaurant admin cannot change their own role!
                         (request.auth.uid != userId || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                       ) || 
                       (
                         resource.data.get('restaurantId', null) != null &&
                         isRestaurantStaff(resource.data.get('restaurantId', null)) &&
                         resource.data.get('role', '') == 'customer' &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                       ) || 
                       // Self-profile update: CANNOT touch role, permissions, status, restaurantId or restaurantIds
                       (
                         isAuthenticated() &&
                         (request.auth.uid == userId || resource.data.get('authUid', '') == request.auth.uid) &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'restaurantId', 'restaurantIds', 'status', 'permissions'])
                       );
      allow delete: if (
                        isSuperAdmin() && 
                        resource.data.get('email', '') != 'pcristo35@gmail.com' &&
                        !(request.auth.uid == userId && resource.data.get('role', '') in ['super_admin', 'superadmin'])
                      ) || 
                      (
                        resource.data.get('restaurantId', null) != null && 
                        isRestaurantAdmin(resource.data.get('restaurantId', null)) && 
                        resource.data.get('role', '') != 'super_admin' &&
                        resource.data.get('role', '') != 'superadmin' &&
                        request.auth.uid != userId
                      );
    }

    // Phone verifications
    match /phone_verifications/{phone} {
      allow get: if true;
      allow create, update: if true;
    }

    // Custom Domains directory
    match /domains/{domainId} {
      allow read: if true; // Custom domain hostname lookup
      allow create, delete: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)));
      allow update: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
    }

    match /restaurant_domains/{domainId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)));
      allow update: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
    }

    // Plans & Subscriptions
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
      allow create, update: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)));
      allow delete: if isSuperAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
      allow create, update: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)));
      allow delete: if isSuperAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
      allow create: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)));
      allow update, delete: if isSuperAdmin();
    }

    match /payment_methods/{methodId} {
      allow read, delete: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
      allow create, update: if isSuperAdmin() || (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)));
    }

    // SaaS Audit Logs (Tenant-isolated)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
      allow create: if true;
      allow update, delete: if false; // Immutable audit log
    }

    // Platform SaaS Settings & Feature Flags
    match /platform_settings/{settingId} {
      allow read: if settingId == 'feature_flags' || settingId == 'general' || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Super Admin Invitations (Single-use, time-limited, revocation-enforced)
    match /super_admin_invitations/{inviteId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && 
        request.auth.token.email != null && 
        (resource.data.get('email', '') == request.auth.token.email.lower() || resource.data.get('email', '') == request.auth.token.email)
      );
      allow get: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isAuthenticated() && 
        request.auth.token.email != null && 
        resource.data.get('status', '') == 'pending' &&
        (resource.data.get('email', '') == request.auth.token.email.lower() || resource.data.get('email', '') == request.auth.token.email) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'declinedAt']) &&
        request.resource.data.get('status', '') in ['accepted', 'declined']
      );
    }

    // Restaurant Staff & Admin Invitations (Single-use, time-limited, restaurant-scoped)
    match /invitations/{inviteId} {
      allow read: if isSuperAdmin() || 
                     (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null))) ||
                     (isAuthenticated() && request.auth.token.email != null && (resource.data.get('email', '') == request.auth.token.email.lower() || resource.data.get('email', '') == request.auth.token.email));
      allow create: if isSuperAdmin() || 
                       (request.resource.data.get('restaurantId', null) != null && isRestaurantAdmin(request.resource.data.get('restaurantId', null)) && request.resource.data.get('role', '') in ['staff', 'restaurant_staff', 'admin', 'restaurant_manager']);
      allow update: if isSuperAdmin() || 
                       (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null))) ||
                       (
                         isAuthenticated() && 
                         resource.data.get('status', '') == 'pending' &&
                         request.auth.token.email != null && 
                         (resource.data.get('email', '') == request.auth.token.email.lower() || resource.data.get('email', '') == request.auth.token.email) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'declinedAt']) &&
                         request.resource.data.get('status', '') in ['accepted', 'declined']
                       );
      allow delete: if isSuperAdmin() || (resource.data.get('restaurantId', null) != null && isRestaurantAdmin(resource.data.get('restaurantId', null)));
    }

    // Smart alerts
    match /smart_alerts/{alertId} {
      allow read, write: if isAuthenticated();
    }

    // Assistance Requests
    match /assistance_requests/{requestId} {
      allow read, write, delete: if isAuthenticated();
    }
  }
}
